<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Addons" oor:package="org.openoffice.Office">
 <node oor:name="AddonUI">
  <node oor:name="OfficeToolbarMerging">
   <node oor:name="fr.github.gaborjager.calcmap.toolbar" oor:op="replace">
    <node oor:name="T1" oor:op="replace">
     <prop oor:name="MergeToolBar"><value>standardbar</value></prop>
     <prop oor:name="MergePoint"><value>.uno:InsertObjectChart</value></prop>
     <prop oor:name="MergeCommand"><value>AddAfter</value></prop>
     <prop oor:name="MergeCommandParameter"><value/></prop>
     <prop oor:name="MergeFallback"><value>AddLast</value></prop>
     <prop oor:name="MergeContext"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
     <node oor:name="ToolBarItems">
      <node oor:name="B1" oor:op="replace">
       <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:CalcMap.CalcMap.CalcMap?language=Basic&amp;location=application</value></prop>
       <prop oor:name="Title" oor:type="xs:string" oor:localized="true"><value xml:lang="en-US">CalcMap: color a map</value><value xml:lang="fr">CalcMap : colorier une carte</value><value xml:lang="ar">CalcMap: تلوين خريطة</value><value xml:lang="bg">CalcMap: оцветяване на карта</value><value xml:lang="cs">CalcMap: vybarvit mapu</value><value xml:lang="da">CalcMap: farvelæg et kort</value><value xml:lang="de">CalcMap: Karte einfärben</value><value xml:lang="el">CalcMap: χρωματισμός χάρτη</value><value xml:lang="es">CalcMap: colorear un mapa</value><value xml:lang="et">CalcMap: värvi kaart</value><value xml:lang="fi">CalcMap: väritä kartta</value><value xml:lang="ga">CalcMap: dathaigh léarscáil</value><value xml:lang="hi">CalcMap: मानचित्र में रंग भरें</value><value xml:lang="hr">CalcMap: oboji kartu</value><value xml:lang="hu">CalcMap: térkép kiszínezése</value><value xml:lang="id">CalcMap: warnai peta</value><value xml:lang="it">CalcMap: colora una mappa</value><value xml:lang="ja">CalcMap：地図を塗り分け</value><value xml:lang="ko">CalcMap: 지도 색칠</value><value xml:lang="lt">CalcMap: nuspalvinti žemėlapį</value><value xml:lang="lv">CalcMap: iekrāsot karti</value><value xml:lang="mt">CalcMap: ikkulura mappa</value><value xml:lang="nb">CalcMap: fargelegg et kart</value><value xml:lang="nl">CalcMap: kaart inkleuren</value><value xml:lang="pl">CalcMap: pokoloruj mapę</value><value xml:lang="pt">CalcMap: colorir um mapa</value><value xml:lang="ro">CalcMap: colorează o hartă</value><value xml:lang="ru">CalcMap: раскрасить карту</value><value xml:lang="sk">CalcMap: vyfarbiť mapu</value><value xml:lang="sl">CalcMap: pobarvaj zemljevid</value><value xml:lang="sv">CalcMap: färglägg en karta</value><value xml:lang="tr">CalcMap: harita renklendir</value><value xml:lang="uk">CalcMap: розфарбувати карту</value><value xml:lang="zh">CalcMap：为地图着色</value></prop>
       <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
      </node>
     </node>
    </node>
   </node>
  </node>
  <node oor:name="OfficeMenuBarMerging">
   <node oor:name="fr.github.gaborjager.calcmap.menu" oor:op="replace">
    <node oor:name="m1" oor:op="replace">
     <prop oor:name="MergePoint"><value>.uno:ToolsMenu\.uno:MacrosMenu</value></prop>
     <prop oor:name="MergeCommand"><value>AddAfter</value></prop>
     <prop oor:name="MergeFallback"><value>AddPath</value></prop>
     <prop oor:name="MergeContext"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
     <node oor:name="MenuItems">
      <node oor:name="m1" oor:op="replace">
       <prop oor:name="URL" oor:type="xs:string"><value>vnd.sun.star.script:CalcMap.CalcMap.CalcMap?language=Basic&amp;location=application</value></prop>
       <prop oor:name="Title" oor:type="xs:string" oor:localized="true"><value xml:lang="en-US">CalcMap: color a map…</value><value xml:lang="fr">CalcMap : colorier une carte…</value><value xml:lang="ar">CalcMap: تلوين خريطة…</value><value xml:lang="bg">CalcMap: оцветяване на карта…</value><value xml:lang="cs">CalcMap: vybarvit mapu…</value><value xml:lang="da">CalcMap: farvelæg et kort…</value><value xml:lang="de">CalcMap: Karte einfärben…</value><value xml:lang="el">CalcMap: χρωματισμός χάρτη…</value><value xml:lang="es">CalcMap: colorear un mapa…</value><value xml:lang="et">CalcMap: värvi kaart…</value><value xml:lang="fi">CalcMap: väritä kartta…</value><value xml:lang="ga">CalcMap: dathaigh léarscáil…</value><value xml:lang="hi">CalcMap: मानचित्र में रंग भरें…</value><value xml:lang="hr">CalcMap: oboji kartu…</value><value xml:lang="hu">CalcMap: térkép kiszínezése…</value><value xml:lang="id">CalcMap: warnai peta…</value><value xml:lang="it">CalcMap: colora una mappa…</value><value xml:lang="ja">CalcMap：地図を塗り分け…</value><value xml:lang="ko">CalcMap: 지도 색칠…</value><value xml:lang="lt">CalcMap: nuspalvinti žemėlapį…</value><value xml:lang="lv">CalcMap: iekrāsot karti…</value><value xml:lang="mt">CalcMap: ikkulura mappa…</value><value xml:lang="nb">CalcMap: fargelegg et kart…</value><value xml:lang="nl">CalcMap: kaart inkleuren…</value><value xml:lang="pl">CalcMap: pokoloruj mapę…</value><value xml:lang="pt">CalcMap: colorir um mapa…</value><value xml:lang="ro">CalcMap: colorează o hartă…</value><value xml:lang="ru">CalcMap: раскрасить карту…</value><value xml:lang="sk">CalcMap: vyfarbiť mapu…</value><value xml:lang="sl">CalcMap: pobarvaj zemljevid…</value><value xml:lang="sv">CalcMap: färglägg en karta…</value><value xml:lang="tr">CalcMap: harita renklendir…</value><value xml:lang="uk">CalcMap: розфарбувати карту…</value><value xml:lang="zh">CalcMap：为地图着色…</value></prop>
       <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
      </node>
     </node>
    </node>
   </node>
  </node>
  <node oor:name="Images">
   <node oor:name="fr.github.gaborjager.calcmap.img" oor:op="replace">
    <prop oor:name="URL"><value>vnd.sun.star.script:CalcMap.CalcMap.CalcMap?language=Basic&amp;location=application</value></prop>
    <node oor:name="UserDefinedImages">
     <prop oor:name="ImageSmallURL"><value>%origin%/icons/map_16.png</value></prop>
     <prop oor:name="ImageBigURL"><value>%origin%/icons/map_26.png</value></prop>
    </node>
   </node>
   <!-- "Map settings…" entry of the context menu (added by
        InterceptMenu): LibreOffice uses the icon associated with its URL -->
   <node oor:name="fr.github.gaborjager.calcmap.img.config" oor:op="replace">
    <prop oor:name="URL"><value>vnd.sun.star.script:CalcMap.CalcMap.ConfigureMap?language=Basic&amp;location=application</value></prop>
    <node oor:name="UserDefinedImages">
     <prop oor:name="ImageSmallURL"><value>%origin%/icons/map_16.png</value></prop>
     <prop oor:name="ImageBigURL"><value>%origin%/icons/map_26.png</value></prop>
    </node>
   </node>
  </node>
 </node>
</oor:component-data>
