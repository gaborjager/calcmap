<?xml version="1.0" encoding="UTF-8"?>
<!-- CalcMap settings, in the LibreOffice configuration:
     /fr.github.gaborjager.CalcMap/Settings. Can be changed by the user
     (Tools > Options > Advanced > Open Expert Configuration, search for
     "CalcMap") or enforced by an administrator (deployed .xcu file). -->
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="CalcMap" oor:package="fr.github.gaborjager" xml:lang="en-US">
 <templates/>
 <component>
  <group oor:name="Settings">
   <!-- Aggregated catalog (list of sources) or catalog of maps, as https:// or file:/// -->
   <prop oor:name="Catalog" oor:type="xs:string">
    <value>https://raw.githubusercontent.com/gaborjager/calcmap/main/catalogue/catalogue.json</value>
   </prop>
   <!-- Maps offered: at most this number of zones (300: world countries map) -->
   <prop oor:name="MaxZones" oor:type="xs:int">
    <value>300</value>
   </prop>
  </group>
 </component>
</oor:component-schema>
