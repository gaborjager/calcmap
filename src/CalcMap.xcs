<?xml version="1.0" encoding="UTF-8"?>
<!-- Paramètres de CalcMap, dans la configuration de LibreOffice :
     /fr.github.gaborjager.CalcMap/Parametres. Modifiables par l'utilisateur
     (Outils > Options > Avancé > Ouvrir la configuration avancée, chercher
     « CalcMap ») ou imposés par un administrateur (fichier .xcu déployé). -->
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="CalcMap" oor:package="fr.github.gaborjager" xml:lang="en-US">
 <templates/>
 <component>
  <group oor:name="Parametres">
   <!-- Catalogue agrégé (liste de sources) ou catalogue de cartes, en https:// ou file:/// -->
   <prop oor:name="Catalogue" oor:type="xs:string">
    <value>https://raw.githubusercontent.com/gaborjager/calcmap/main/catalogue/catalogue.json</value>
   </prop>
   <!-- Cartes proposées : au plus ce nombre de zones -->
   <prop oor:name="ZonesMax" oor:type="xs:int">
    <value>200</value>
   </prop>
  </group>
 </component>
</oor:component-schema>
